LIB_INCS= 	afterstep.h asapp.h ascommand.h asdatabase.h asfeel.h aswindata.h \
		  balloon.h canvas.h clientprops.h colorscheme.h \
		  decor.h desktop_category.h event.h freestor.h \
		  functions.h font.h hints.h \
                  kde.h moveresize.h myicon.h \
		  mylook.h mystyle.h mystyle_property.h \
		  parser.h screen.h shape.h \
		  session.h wmprops.h


# removed : mystrcasecmp.o mystrdup.o safemalloc.o
#           sleep.o hostname.o getfdwidth.o
#           audit.o strncmp.o homeanddirs.o
#           findfile.o asproperty.o catstring3.o copystring.o termhash.o
#
LIB_OBJS= asapp.o asapp_env.o asapp_spawn.o ascommand.o asdatabase.o asfeel.o aswindata.o \
				balloon.o canvas.o canvas_x11.o clientprops.o clientprops_read.o clientprops_write.o colorscheme.o \
				decor.o decor_astbar.o decor_render.o desktop_category.o desktop_category_entries.o event.o \
				freestor.o freestor_read.o freestor_write.o functions.o functions_terms.o font.o hints.o hints_common.o hints_common_io.o hints_icccm.o hints_motif.o hints_gnome.o hints_kde.o hints_extwm.o hints_xresources.o hints_asdb.o kde.o module.o \
				moveresize.o moveresize_constraints.o myicon.o mylook.o mystyle.o mystyle_core.o mystyle_parse.o mystyle_property.o \
				outline.o operations.o parser.o parser_scan.o parser_fs.o parser_xml.o \
				screen.o session.o session_files.o shape.o wmprops.o wmprops_write.o

LIB_SOURCES= asapp.c asapp_env.c asapp_spawn.c ascommand.c asdatabase.c asfeel.c aswindata.c \
				balloon.c canvas.c canvas_x11.c clientprops.c clientprops_read.c clientprops_write.c colorscheme.c \
				decor.c decor_astbar.c decor_render.c desktop_category.c desktop_category_entries.c event.c \
				freestor.c freestor_read.c freestor_write.c functions.c functions_terms.c font.c hints.c hints_common.c hints_common_io.c hints_icccm.c hints_motif.c hints_gnome.c hints_kde.c hints_extwm.c hints_xresources.c hints_asdb.c kde.c module.c \
				moveresize.c moveresize_constraints.c myicon.c mylook.c mystyle.c mystyle_core.c mystyle_parse.c mystyle_property.c \
				outline.c operations.c parser.c parser_scan.c parser_fs.c parser_xml.c \
				screen.c session.c session_files.c shape.c wmprops.c wmprops_write.c

CONFIG_SCRIPT= afterstep-config

LIB_DIR_NAME    = libAfterStep
LIB_NAME        = LIBAFTERSTEP
LIB_STATIC      = libAfterStep.a
LIB_SHARED      = libAfterStep.so
LIB_SHARED_CYG  = cygAfterStep.dll
LIB_SHARED_CYG_AR  = libAfterStep.dll.a
LIBVER          = @libafterstep_version@
LIBVERMAJOR     = @libafterstep_version_major@

LIBS_PRIVATE      = ../src/afterstep/$(LIB_AFTERIMAGE) ../src/afterstep/$(LIB_AFTERBASE)  $(LIBS_AFTERIMAGE)

@MAKEFILECOMMONLIB@


test_parser_xml.o: parser_xml.c
		$(CC) $(CCFLAGS) $(EXTRA_DEFINES) -DTEST_PARSER_XML $(INCLUDES) $(EXTRA_INCLUDES) -c parser_xml.c -o test_parser_xml.o

test_parser_xml:	test_parser_xml.o ../libAfterConf/libAfterConf.a ../libAfterStep/libAfterStep.a ../libAfterBase/libAfterBase.a
		$(CC) test_parser_xml.o ../libAfterConf/libAfterConf.a ../libAfterStep/libAfterStep.a $(USER_LD_FLAGS) $(LIBS_ALL) $(LIBS_AFTERIMAGE) -o test_parser_xml

test_parser_fs.o: parser_fs.c
		$(CC) $(CCFLAGS) $(EXTRA_DEFINES) -DTEST_PARSER_FS $(INCLUDES) $(EXTRA_INCLUDES) -c parser_fs.c -o test_parser_fs.o

test_parser_fs:	test_parser_fs.o ../libAfterConf/libAfterConf.a ../libAfterStep/libAfterStep.a ../libAfterBase/libAfterBase.a
		$(CC) test_parser_fs.o ../libAfterConf/libAfterConf.a ../libAfterStep/libAfterStep.a $(USER_LD_FLAGS) $(LIBS_ALL) $(LIBS_AFTERIMAGE) -o test_parser_fs
