# AfterStep Wayland default autostart.
#
# Installed by `make install.wayland` into:
#   $prefix/share/afterstep/wayland/aswlcomp.autostart
#
# Note: the Wayland session wrapper sets `ASWLPANEL_CONFIG` and `ASWLMENU_CONFIG`
# to user overrides (if present) or to the system defaults in the same directory.

# Background (AfterStep XML background renderer).
exec aswlbg

# Wharf-ish panel.
exec aswlpanel

# Common key bindings:
bind Alt+Return exec "${TERMINAL:-foot}"
bind Alt+d exec "fuzzel || bemenu-run || wofi --show drun"
bind Alt+space exec "aswlmenu"
bind Alt+Tab focus_next
bind Alt+Shift+Tab focus_prev
bind Alt+f fullscreen
bind Alt+m maximize
bind Alt+Left workspace_prev
bind Alt+Right workspace_next
bind Alt+1 workspace 1
bind Alt+2 workspace 2
bind Alt+3 workspace 3
bind Alt+4 workspace 4
bind Alt+q close_focused
bind Alt+Shift+l lock

